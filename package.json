{
  "name": "sts2-ai-platform-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Shared STS2 Host, Player Environment and human evidence platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "components/connector/sdk/typescript",
    "components/host-runtime",
    "components/annotator"
  ],
  "scripts": {
    "identity": "node tools/component-identity.mjs",
    "check:identity": "node --test tools/component-identity.test.mjs && node tools/component-identity.mjs >/dev/null",
    "check:boundaries": "node --test tools/check-boundaries.test.mjs && node tools/check-boundaries.mjs",
    "check:history": "node tools/check-migration-history.mjs",
    "check:components": "npm --prefix components/connector run check && npm --prefix components/host-runtime run check && npm --prefix components/annotator run test",
    "check": "npm run check:identity && npm run check:boundaries && npm run check:history && npm run check:components",
    "check:exact-game": "npm --prefix components/connector run build && npm --prefix components/annotator run check",
    "build": "npm --prefix components/connector run build && npm --prefix components/annotator run build",
    "doctor": "node tools/platform-doctor.mjs",
    "connector:doctor": "npm --prefix components/connector run doctor",
    "connector:build": "npm --prefix components/connector run build",
    "connector:deploy": "npm --prefix components/connector run deploy",
    "connector:verify-loaded": "npm --prefix components/connector run verify:loaded",
    "connector:rollback": "npm --prefix components/connector run rollback",
    "host:setup": "npm --prefix components/host-runtime run setup",
    "host:doctor": "npm --prefix components/host-runtime run doctor",
    "host:start": "npm --prefix components/host-runtime run start",
    "host:status": "npm --prefix components/host-runtime run status",
    "host:stop": "npm --prefix components/host-runtime run stop",
    "host:bootstrap-profile": "npm --prefix components/host-runtime run bootstrap:profile",
    "host:probe-shipped": "npm --prefix components/host-runtime run probe:shipped",
    "host:probe-menu-control": "npm --prefix components/host-runtime run probe:menu-control",
    "host:probe-journey": "npm --prefix components/host-runtime run probe:journey",
    "annotator:doctor": "node components/annotator/tools/annotator.mjs doctor",
    "annotator:build": "node components/annotator/tools/annotator.mjs build",
    "annotator:deploy": "node components/annotator/tools/annotator.mjs deploy",
    "annotator:prepare-mods": "node components/annotator/tools/annotator.mjs prepare-mod-settings",
    "annotator:admit-modset": "node components/annotator/tools/annotator.mjs admit-current-modset",
    "annotator:rollback": "node components/annotator/tools/annotator.mjs rollback",
    "annotator:launch": "node components/annotator/tools/annotator.mjs launch",
    "annotator:launch-live-connector": "node components/annotator/tools/annotator.mjs launch-live-connector",
    "annotator:verify-loaded": "node components/annotator/tools/annotator.mjs verify-loaded",
    "annotator:audit": "node components/annotator/tools/annotator.mjs audit",
    "annotator:pack-session": "node components/annotator/tools/annotator.mjs pack-session"
  }
}
