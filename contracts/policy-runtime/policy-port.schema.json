{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2.policy-runtime/policy-port-1",
  "title": "STS2 decision-only NDJSON Policy Port",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "message_type", "request_id", "input"],
      "properties": {
        "schema": { "const": "sts2.policy-runtime/policy-port-1" },
        "message_type": { "const": "decide" },
        "request_id": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "manifest", "bundle", "candidate_digest", "candidate_count"],
          "properties": {
            "run_id": { "type": "string", "minLength": 1 },
            "manifest": { "$ref": "policy-manifest.schema.json" },
            "bundle": {
              "type": "object",
              "additionalProperties": false,
              "required": ["observation", "reads"],
              "properties": {
                "observation": { "type": "object" },
                "reads": { "type": "array", "items": { "type": "object" } }
              }
            },
            "candidate_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "candidate_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "message_type", "request_id", "output"],
      "properties": {
        "schema": { "const": "sts2.policy-runtime/policy-port-1" },
        "message_type": { "const": "decision" },
        "request_id": { "type": "string", "minLength": 1 },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_digest", "scores", "selected_index"],
          "properties": {
            "candidate_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "scores": { "type": "array", "items": { "type": "number" } },
            "selected_index": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "message_type", "request_id", "error"],
      "properties": {
        "schema": { "const": "sts2.policy-runtime/policy-port-1" },
        "message_type": { "const": "error" },
        "request_id": { "type": "string", "minLength": 1 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  ]
}
